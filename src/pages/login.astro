---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Acceso privado | MLABS Music"
  description="Inicia sesión o crea tu cuenta en MLABS Music para acceder a apps, herramientas privadas y módulos musicales en desarrollo."
  canonicalPath="/login"
  bodyClass="app-body"
>
  <div class="page-wrap">
    <header class="site-header">
      <nav class="nav" aria-label="Principal">
        <a class="brand" href="/">MLABS MUSIC</a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primaryMenu" aria-label="Abrir menu">
          <span></span><span></span><span></span>
        </button>
        <div class="nav-links" id="primaryMenu">
          <a href="/">Inicio</a>
          <a href="/#portfolio">Portfolio</a>
          <a href="/workspace">Workspace</a>
          <a class="is-auth-hidden" href="/admin" data-auth-link="admin">Admin</a>
        </div>
      </nav>
    </header>

    <main class="auth-screen">
      <section class="auth-panel reveal" aria-labelledby="loginTitle">
        <p class="eyebrow">Acceso privado</p>
        <h1 id="loginTitle">Accede con tu email.</h1>
        <p id="authIntro">
          Escribe tu email y comprobaremos si ya hay una sesión activa para continuar.
        </p>

        <form class="auth-form" id="authForm">
          <div class="auth-progress" aria-hidden="true"></div>
          <div class="auth-email-summary" data-email-summary hidden>
            <span>Email</span>
            <strong id="selectedEmailLabel"></strong>
          </div>
          <label data-email-field>
            Email
            <input id="email" name="email" type="email" autocomplete="email" required placeholder="tu@email.com" />
          </label>
          <label data-password-field>
            <span id="passwordLabel">Contraseña</span>
            <input id="password" name="password" type="password" autocomplete="current-password" minlength="6" />
          </label>
          <label data-confirm-field>
            Confirmar contraseña
            <input id="passwordConfirm" name="passwordConfirm" type="password" autocomplete="new-password" minlength="6" />
          </label>
          <div class="auth-actions">
            <button class="button primary" type="submit" id="authSubmitButton">Continuar</button>
          </div>
          <div class="auth-secondary-actions">
            <button type="button" data-auth-action="signin" hidden>Ya tengo cuenta</button>
            <button type="button" data-auth-action="recover" hidden>He olvidado mi contraseña</button>
            <button type="button" data-auth-action="change-email" hidden>Cambiar email</button>
          </div>
          <p class="auth-message" id="authMessage" role="status"></p>
        </form>
      </section>
    </main>
  </div>

  <script>
    import { supabase, isSupabaseConfigured } from '../lib/supabase';

    const form = document.getElementById('authForm');
    const title = document.getElementById('loginTitle');
    const intro = document.getElementById('authIntro');
    const message = document.getElementById('authMessage');
    const submitButton = document.getElementById('authSubmitButton');
    const passwordLabel = document.getElementById('passwordLabel');
    const emailSummary = document.querySelector('[data-email-summary]');
    const selectedEmailLabel = document.getElementById('selectedEmailLabel');
    const emailField = document.querySelector('[data-email-field]');
    const passwordField = document.querySelector('[data-password-field]');
    const confirmField = document.querySelector('[data-confirm-field]');
    const actionButtons = document.querySelectorAll('[data-auth-action]');
    const nextUrl = new URL(window.location.href).searchParams.get('next') || '/workspace';
    const initialMode = new URL(window.location.href).searchParams.get('mode') || '';
    const preferredMode = initialMode === 'signin' ? 'signin' : 'signup';
    let currentMode = initialMode === 'update' ? 'update' : 'email';
    let selectedEmail = '';
    let detectedSessionEmail = '';

    function setMessage(text, tone = 'info') {
      if (!message) return;
      message.textContent = text;
      message.dataset.tone = tone;
    }

    function setChecking(isChecking) {
      form?.classList.toggle('is-checking', isChecking);
      if (submitButton) submitButton.disabled = isChecking;
    }

    function setFieldHidden(element, hidden) {
      if (!element) return;
      element.toggleAttribute('hidden', hidden);
      element.setAttribute('aria-hidden', String(hidden));
      for (const input of element.querySelectorAll('input')) {
        input.required = !hidden && input.dataset.required === 'true';
      }
    }

    function setMode(mode, replaceUrl = true) {
      currentMode = mode;
      setMessage('');

      const isEmail = mode === 'email';
      const isSignup = mode === 'signup';
      const isRecover = mode === 'recover';
      const isUpdate = mode === 'update';
      const isSignin = mode === 'signin';
      const hasEmail = Boolean(selectedEmail);

      title.textContent = isEmail
        ? 'Accede con tu email.'
        : isSignup
          ? 'Crear cuenta.'
        : isRecover
          ? 'Recupera el acceso a tu cuenta.'
          : isUpdate
            ? 'Crea una contraseña nueva.'
            : 'Escribe tu contraseña.';

      intro.textContent = isEmail
        ? 'Escribe tu email y comprobaremos si ya hay una sesión activa para continuar.'
        : isSignup
          ? 'No hay una sesión activa para este email. Crea una contraseña y confirma la contraseña para abrir tu cuenta MLABS.'
        : isRecover
          ? 'Te enviaremos un enlace seguro para recuperar tu contraseña.'
          : isUpdate
            ? 'Introduce una nueva contraseña para terminar la recuperación de acceso.'
            : detectedSessionEmail
              ? 'Sesión detectada. Confirma tu contraseña para entrar a tu espacio privado.'
              : 'Usa la contraseña de tu cuenta MLABS para entrar.';

      setFieldHidden(emailField, !isEmail);
      setFieldHidden(emailSummary, isEmail || isUpdate || !hasEmail);
      setFieldHidden(passwordField, isEmail || isRecover);
      setFieldHidden(confirmField, !(isSignup || isUpdate));

      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');
      const confirmInput = document.getElementById('passwordConfirm');

      if (selectedEmailLabel) selectedEmailLabel.textContent = selectedEmail;
      emailInput.required = isEmail;
      passwordInput.required = isSignin || isSignup || isUpdate;
      confirmInput.required = isSignup || isUpdate;
      passwordInput.autocomplete = isSignup || isUpdate ? 'new-password' : 'current-password';
      passwordLabel.textContent = isUpdate ? 'Nueva contraseña' : 'Contraseña';

      submitButton.textContent = isEmail
        ? 'Continuar'
        : isSignup
          ? 'Crear cuenta y entrar'
        : isRecover
          ? 'Enviar enlace'
          : isUpdate
            ? 'Guardar contraseña'
            : 'Iniciar sesión';

      for (const button of actionButtons) {
        const action = button.dataset.authAction;
        const visible = (
          (action === 'signin' && (isSignup || isRecover)) ||
          (action === 'recover' && isSignin) ||
          (action === 'change-email' && !isEmail && !isUpdate)
        );
        button.hidden = !visible;
      }

      if (replaceUrl) {
        const url = new URL(window.location.href);
        if (mode === 'email') url.searchParams.delete('mode');
        else if (mode !== 'signup' || initialMode === 'signup') url.searchParams.set('mode', mode);
        window.history.replaceState({}, '', url);
      }
    }

    if (!isSupabaseConfigured || !supabase) {
      setMessage('Faltan PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY en el entorno.', 'error');
    } else {
      const { data } = await supabase.auth.getSession();
      if (data.session?.user?.email && currentMode !== 'update') {
        detectedSessionEmail = data.session.user.email.toLowerCase();
        selectedEmail = detectedSessionEmail;
        setMode('signin', false);
        setMessage(`Sesión detectada para ${selectedEmail}.`, 'success');
      }

      supabase.auth.onAuthStateChange((event) => {
        if (event === 'PASSWORD_RECOVERY') {
          setMode('update');
          setMessage('Enlace verificado. Escribe tu nueva contraseña.', 'success');
        }
      });
    }

    setMode(currentMode, false);

    for (const button of actionButtons) {
      button.addEventListener('click', () => {
        const action = button.dataset.authAction;
        if (action === 'change-email') {
          selectedEmail = '';
          detectedSessionEmail = '';
          setMode('email');
          return;
        }
        if (action === 'signin' || action === 'signup' || action === 'recover') {
          setMode(action);
        }
      });
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const email = String(formData.get('email') || '').trim().toLowerCase();
      const password = String(formData.get('password') || '');
      const passwordConfirm = String(formData.get('passwordConfirm') || '');

      if (currentMode === 'email') {
        if (!email) {
          setMessage('Escribe tu email para continuar.', 'error');
          return;
        }
        setChecking(true);
        setMessage('Comprobando sesión...', 'info');
        if (supabase) {
          const { data } = await supabase.auth.getSession();
          detectedSessionEmail = data.session?.user?.email?.toLowerCase() || '';
        }
        selectedEmail = email;
        await new Promise((resolve) => window.setTimeout(resolve, 260));
        setChecking(false);
        setMode(detectedSessionEmail && selectedEmail === detectedSessionEmail ? 'signin' : preferredMode);
        return;
      }

      if (!supabase) {
        setMessage('Faltan PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY en el entorno.', 'error');
        return;
      }

      if ((currentMode === 'signup' || currentMode === 'update') && password !== passwordConfirm) {
        setMessage('Las contraseñas no coinciden.', 'error');
        return;
      }

      submitButton.disabled = true;
      setMessage(
        currentMode === 'signup'
          ? 'Creando tu cuenta...'
          : currentMode === 'recover'
            ? 'Preparando el email de recuperación...'
            : currentMode === 'update'
              ? 'Guardando nueva contraseña...'
              : 'Entrando en MLABS...',
      );

      const redirectTo = `${window.location.origin}/login?next=${encodeURIComponent(nextUrl)}`;
      const result = currentMode === 'signup'
        ? await supabase.auth.signUp({
            email: selectedEmail,
            password,
            options: {
              emailRedirectTo: redirectTo,
              data: {
                account_type: 'music_user',
                source: 'mlabs_music_web',
              },
            },
          })
        : currentMode === 'recover'
          ? await supabase.auth.resetPasswordForEmail(selectedEmail, {
              redirectTo: `${window.location.origin}/login?mode=update&next=${encodeURIComponent(nextUrl)}`,
            })
          : currentMode === 'update'
            ? await supabase.auth.updateUser({ password })
            : await supabase.auth.signInWithPassword({ email: selectedEmail, password });

      submitButton.disabled = false;

      if (result.error) {
        setMessage(
          currentMode === 'signin'
            ? 'No hemos podido entrar con ese email y contraseña. Puedes recuperar la contraseña o crear una cuenta nueva si es tu primer acceso.'
            : result.error.message,
          'error',
        );
        return;
      }

      if (currentMode === 'signup') {
        if (result.data?.session) {
          setMessage('Cuenta creada. Entrando al portal...', 'success');
          window.location.assign(nextUrl);
        } else {
          setMessage('Cuenta creada. Entrando al portal...', 'success');
          const signInResult = await supabase.auth.signInWithPassword({ email: selectedEmail, password });
          if (!signInResult.error) {
            window.location.assign(nextUrl);
            return;
          }
          setMessage('Cuenta creada. Supabase requiere confirmar el email antes de poder entrar directo.', 'success');
        }
        return;
      }

      if (currentMode === 'recover') {
        setMessage('Si el email existe, recibirás un enlace para recuperar la contraseña.', 'success');
        return;
      }

      if (currentMode === 'update') {
        setMessage('Contraseña actualizada. Redirigiendo a tu espacio...', 'success');
        window.location.assign(nextUrl);
        return;
      }

      setMessage('Sesión iniciada. Redirigiendo a tu espacio...', 'success');
      window.location.assign(nextUrl);
    });
  </script>
</BaseLayout>
