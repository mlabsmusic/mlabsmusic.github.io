---
import BaseLayout from '../layouts/BaseLayout.astro';
import { appCatalog } from '../data/appCatalog';

const companyPillars = [
  {
    title: 'Software musical a medida',
    body: 'Diseñamos herramientas web, apps de escritorio y flujos internos para DJs, crews, sellos, promotoras y marcas musicales.',
  },
  {
    title: 'Bibliotecas que se entienden',
    body: 'Convertimos carpetas, catálogos y archivos dispersos en interfaces claras para buscar, revisar, preparar y compartir música.',
  },
  {
    title: 'Automatización para operar mejor',
    body: 'Creamos sistemas que reducen trabajo repetitivo: lectura de carpetas, snapshots, playlists, diagnósticos, revisión y reporting.',
  },
];

const serviceLines = [
  {
    label: 'Apps para DJs',
    title: 'Herramientas que nacen de problemas reales de cabina y biblioteca.',
    body: 'Organización musical, preparación de sesiones, sincronización, control de duplicados, análisis de librería y utilidades para Rekordbox, Apple Music y flujos locales.',
  },
  {
    label: 'Web apps musicales',
    title: 'Plataformas privadas para crews, sellos y comunidades.',
    body: 'Dashboards, workspaces, perfiles, catálogos, portales de acceso, áreas privadas y sistemas de revisión para operar música como un producto.',
  },
  {
    label: 'Producto y prototipos',
    title: 'De idea musical a MVP enseñable.',
    body: 'Definimos narrativa, pantallas, arquitectura, demo funcional y roadmap para validar una app antes de invertir en un desarrollo más grande.',
  },
];

const processSteps = [
  {
    step: '01',
    title: 'Detectar el flujo real',
    body: 'Partimos de cómo trabaja el DJ o equipo hoy: carpetas, programas, exportaciones, errores y tareas repetidas.',
  },
  {
    step: '02',
    title: 'Diseñar la herramienta',
    body: 'Transformamos ese flujo en pantallas simples, estados claros, permisos, datos y acciones que ahorran tiempo.',
  },
  {
    step: '03',
    title: 'Construir el piloto',
    body: 'Creamos una versión usable para probar con música real, usuarios concretos y una decisión clara de siguiente fase.',
  },
];

const heroHighlights = [
  'Apps reales',
  'Bibliotecas',
  'Workflows DJ',
];

const productScreens = [
  {
    label: 'Hub de apps',
    src: '/assets/mtools-beta-v2/optimized/01-hub-overview.jpg',
    alt: 'Interfaz del hub de apps MLABS con módulos para DJs y bibliotecas musicales',
  },
  {
    label: 'FolderToTunes',
    src: '/assets/mtools-beta-v2/optimized/02-foldertotunes-main.jpg',
    alt: 'Interfaz de FolderToTunes para conectar carpetas musicales y convertirlas en playlists',
  },
];
---

<BaseLayout
  title="MLABS Music | Software, apps y herramientas digitales para DJs"
  description="MLABS desarrolla software, apps y herramientas digitales para el sector musical: DJs, crews, sellos, promotoras y empresas que necesitan operar mejor su música."
  canonicalPath="/"
>
  <div class="page-wrap">
    <header class="site-header">
      <nav class="nav" aria-label="Principal">
        <a class="brand" href="/">MLABS MUSIC</a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primaryMenu" aria-label="Abrir menu">
          <span></span><span></span><span></span>
        </button>
        <div class="nav-links" id="primaryMenu">
          <a href="#empresa">Empresa</a>
          <a href="#portfolio">Portfolio</a>
          <a href="#servicios">Software</a>
          <a href="#proceso">Proceso</a>
          <a href="/workspace">Workspace</a>
          <a href="/recordpool">Recordpool</a>
        </div>
        <a class="button primary" href="/login">Iniciar sesión</a>
      </nav>
    </header>

    <main>
      <section class="hero recordpool-hero company-hero">
        <video
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster="/assets/video/mlabs-hero-poster.jpg"
          aria-label="Visual de MLABS Music"
        >
          <source src="/assets/video/mlabs-hero-fast.webm" type="video/webm" />
          <source src="/assets/video/mlabs-hero-fast.mp4" type="video/mp4" />
        </video>
        <div class="shell hero-content">
          <div class="hero-copy">
            <p class="eyebrow">Software para música y DJs</p>
            <h1>Software para operar música.</h1>
            <p>
              Apps para convertir bibliotecas, carpetas y decisiones de DJ en productos claros,
              revisables y listos para crecer.
            </p>
            <div class="hero-actions">
              <a class="button primary" href="/demo">Ver demo</a>
              <a class="button ghost" href="#portfolio">Ver portfolio</a>
            </div>
            <div class="hero-proof-row" aria-label="Áreas de producto MLABS">
              {heroHighlights.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>

          <div class="hero-product-stage" aria-label="Vista de producto MLABS">
            <figure class="hero-device hero-device-main">
              <span>{productScreens[0].label}</span>
              <img src={productScreens[0].src} alt={productScreens[0].alt} loading="eager" decoding="async" />
            </figure>
            <figure class="hero-device hero-device-secondary">
              <span>{productScreens[1].label}</span>
              <img src={productScreens[1].src} alt={productScreens[1].alt} loading="eager" decoding="async" />
            </figure>
            <div class="hero-product-caption">
              <strong>MLABS Product OS</strong>
              <span>Recordpool, workspace, agentes locales y herramientas para DJs.</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="empresa">
        <div class="shell">
          <div class="section-head reveal">
            <p class="section-kicker">Qué es MLABS</p>
            <h2>Una empresa de software especializada en música.</h2>
            <p>
              Diseñamos sistemas para gente que trabaja con música cada día: DJs, clubs, crews,
              sellos, promotoras y equipos que necesitan orden, velocidad y criterio.
            </p>
          </div>

          <div class="commercial-grid">
            {companyPillars.map((pillar) => (
              <article class="commercial-card reveal">
                <h3>{pillar.title}</h3>
                <p>{pillar.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section portfolio-section" id="portfolio">
        <div class="shell">
          <div class="section-head reveal">
            <p class="section-kicker">Portfolio de producto</p>
            <h2>Apps y herramientas que estamos construyendo.</h2>
            <p>
              El portfolio de MLABS irá creciendo con productos propios y pilotos privados.
              Algunos módulos ya son navegables; otros están en fase de diseño, validación o beta interna.
            </p>
          </div>

          <div class="portfolio-app-grid" data-elastic-grid>
            {appCatalog.map((app) => (
              <article class="portfolio-app-card reveal" data-elastic-item>
                {'image' in app && app.image ? (
                  <figure class="portfolio-app-shot">
                    <img src={app.image} alt={`Vista de ${app.name}`} loading="lazy" decoding="async" />
                  </figure>
                ) : null}
                <div class="portfolio-app-card-head">
                  <span class="app-icon">{app.icon}</span>
                  <span class="tag">{app.category}</span>
                </div>
                <h3>{app.name}</h3>
                <p>{app.description}</p>
                <div class="portfolio-app-meta">
                  <span>{app.stage}</span>
                  <span>{app.audience}</span>
                </div>
                {app.launch_url && app.launch_url !== '#' ? (
                  <a class="button ghost" href={app.launch_url}>Ver módulo</a>
                ) : (
                  <span class="portfolio-app-note">En desarrollo privado</span>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section commercial-section" id="servicios">
        <div class="shell">
          <div class="section-head reveal">
            <p class="section-kicker">Líneas de software</p>
            <h2>Construimos herramientas prácticas, no escaparates vacíos.</h2>
            <p>
              El objetivo es que cada app tenga un uso claro: ahorrar tiempo, ordenar datos musicales,
              mejorar decisiones y hacer que un equipo pueda trabajar con menos caos.
            </p>
          </div>

          <div class="service-line-grid">
            {serviceLines.map((line) => (
              <article class="service-line-card reveal">
                <span>{line.label}</span>
                <h3>{line.title}</h3>
                <p>{line.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section recordpool-tutorial-section" id="proceso">
        <div class="shell">
          <div class="section-head reveal">
            <p class="section-kicker">Cómo trabajamos</p>
            <h2>Primero entendemos el flujo musical. Después lo convertimos en producto.</h2>
            <p>
              Una buena app musical no empieza por tecnología. Empieza por saber qué duele:
              biblioteca desordenada, exportaciones manuales, duplicados, playlists lentas,
              catálogos invisibles o procesos que dependen de memoria y paciencia.
            </p>
          </div>

          <ol class="steps reveal company-process-steps">
            {processSteps.map((item) => (
              <li class="step">
                <span>{item.step}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="contact">
        <div class="shell contact-layout">
          <div>
            <p class="eyebrow">Siguiente paso</p>
            <h2>Si el problema se repite cada semana, probablemente merece una herramienta propia.</h2>
            <p>
              MLABS puede ayudarte a convertir una idea, un flujo de DJ o una necesidad de equipo musical
              en una app enseñable, usable y preparada para crecer.
            </p>
          </div>
          <div class="contact-actions">
            <a class="button primary" href="/login">Iniciar sesión</a>
            <a class="button ghost" href="/apps">Área privada</a>
          </div>
        </div>
      </section>

      <footer class="site-footer home-footer">
        <div class="shell footer-inner">
          <p>¿Quieres hablar de un proyecto musical?</p>
          <nav aria-label="Contacto y legal">
            <a href="mailto:info@mlabsmusic.com?subject=Proyecto%20software%20musical%20MLABS">Hablar de un proyecto</a>
            <a href="/privacy-policy">Privacidad</a>
            <a href="/terms-of-use">Términos</a>
          </nav>
        </div>
      </footer>
    </main>
  </div>

  <script>
    const heroVideo = document.querySelector('.hero-video');

    if (heroVideo instanceof HTMLVideoElement) {
      let lastVideoTime = 0;
      const tryPlay = async () => {
        try {
          heroVideo.muted = true;
          await heroVideo.play();
        } catch {}
      };

      if (heroVideo.readyState >= 2) {
        void tryPlay();
      } else {
        heroVideo.addEventListener('canplay', () => {
          void tryPlay();
        }, { once: true });
      }

      heroVideo.addEventListener('loadedmetadata', () => {
        if (heroVideo.currentTime === 0) {
          heroVideo.currentTime = 0.04;
        }
      }, { once: true });

      heroVideo.addEventListener('timeupdate', () => {
        if (heroVideo.currentTime < lastVideoTime && lastVideoTime > 1) {
          heroVideo.classList.add('is-loop-cycle');
          window.setTimeout(() => heroVideo.classList.remove('is-loop-cycle'), 440);
        }
        lastVideoTime = heroVideo.currentTime;
      });
    }
  </script>
</BaseLayout>
